    "/occurrences": {
      "post": {
        "description": "Valida a categoria no municipal-service e a localização no limite do concelho (422 se estiver fora).",
        "operationId": "OccurrencesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOccurrenceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
