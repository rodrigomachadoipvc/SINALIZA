    "/stats/dashboard": {
      "get": {
        "description": "`source` indica a origem: `postgres` (base operacional) ou `databricks`.",
        "operationId": "StatsController_dashboard",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Início do período (inclusive). Por omissão, o 1.º dia do mês, há 11 meses.",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Fim do período (inclusive). Por omissão, hoje.",
            "schema": {
