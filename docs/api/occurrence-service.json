                  "$ref": "#/components/schemas/CreatedOccurrenceDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Reportar uma ocorrência (RF03)",
        "tags": [
          "occurrences"
        ]
      },
      "get": {
        "operationId": "OccurrencesController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Pesquisa na referência, morada e descrição.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Um ou mais estados separados por vírgulas. Sem filtro, as anuladas ficam de fora.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": "RECEBIDA,EM_ANALISE"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Slugs de categoria separados por vírgulas.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": "vias"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Criadas a partir deste dia (inclusive).",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Criadas até este dia (inclusive).",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "name": "bbox",
            "required": false,
            "in": "query",
            "description": "oeste,sul,este,norte",
            "schema": {
              "example": "-8.65,41.52,-8.60,41.55",
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "-createdAt",
              "type": "string",
              "enum": [
                "-createdAt",
                "createdAt",
                "-updatedAt",
                "updatedAt",
                "reference",
                "-reference",
                "status",
                "-status",
                "category",
                "-category"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedStaffRowsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Pesquisar e filtrar ocorrências (RF16)",
        "tags": [
          "occurrences"
        ]
      }
    },
    "/occurrences/mine": {
      "get": {
        "operationId": "OccurrencesController_mine",
        "parameters": [
          {
            "name": "page",
