  "info": {
    "title": "Sinaliza · occurrence-service",
    "description": "Ocorrências: registo, ciclo de vida, fotografias, mapa público e indicadores.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CoordinatesDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 41.5317,
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "example": -8.6194,
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "CreateOccurrenceDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 41.5317,
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "example": -8.6194,
            "minimum": -180,
            "maximum": 180
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "example": "Buraco grande na faixa de rodagem junto à passadeira."
          },
          "photoKey": {
            "type": "string",
            "description": "Devolvido por `POST /photos`."
          }
        },
        "required": [
          "lat",
          "lng",
          "categoryId",
          "description"
        ]
      },
      "CreatedOccurrenceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "example": "SIN-2026-00482"
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEBIDA",
              "EM_ANALISE",
              "EM_RESOLUCAO",
              "RESOLVIDA",
              "REJEITADA",
              "DUPLICADA",
              "ANULADA"
            ]
          }
        },
        "required": [
          "id",
          "reference",
          "status"
        ]
      },
      "CategoryRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Vias e pavimento"
          },
          "slug": {
            "type": "string",
            "example": "vias"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "OccurrenceCardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "example": "SIN-2026-00482"
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEBIDA",
              "EM_ANALISE",
              "EM_RESOLUCAO",
              "RESOLVIDA",
              "REJEITADA",
              "DUPLICADA",
              "ANULADA"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/CategoryRefDto"
          },
          "description": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string",
            "nullable": true,
            "description": "URL pré-assinado (15 min)."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "reference",
          "status",
          "category",
          "description",
          "address",
          "photoUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginatedCardsDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OccurrenceCardDto"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "StaffRowDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "example": "SIN-2026-00482"
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEBIDA",
              "EM_ANALISE",
              "EM_RESOLUCAO",
              "RESOLVIDA",
              "REJEITADA",
              "DUPLICADA",
              "ANULADA"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/CategoryRefDto"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "daysOpen": {
            "type": "number",
            "description": "Dias desde a criação: até hoje se estiver em aberto, até à resolução ou à última alteração se estiver fechada."
          }
        },
        "required": [
          "id",
          "reference",
          "status",
          "category",
          "address",
          "lat",
          "lng",
          "createdAt",
          "updatedAt",
          "daysOpen"
        ]
      },
      "PaginatedStaffRowsDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaffRowDto"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "OccurrenceRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "example": "SIN-2026-00410"
          }
        },
        "required": [
          "id",
          "reference"
        ]
      },
      "HistoryEntryDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "RECEBIDA",
              "EM_ANALISE",
              "EM_RESOLUCAO",
              "RESOLVIDA",
              "REJEITADA",
              "DUPLICADA",
              "ANULADA"
            ],
            "nullable": true
          },
          "to": {
            "type": "string",
            "enum": [
              "RECEBIDA",
              "EM_ANALISE",
              "EM_RESOLUCAO",
              "RESOLVIDA",
              "REJEITADA",
              "DUPLICADA",
              "ANULADA"
            ]
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "changedByRole": {
            "type": "string",
            "enum": [
              "CIDADAO",
              "GESTOR",
              "ADMIN"
            ],
            "description": "Perfil de quem fez a alteração."
          },
          "changedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "from",
          "to",
          "note",
          "reason",
          "changedByRole",
          "changedAt"
        ]
      },
      "CitizenDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
