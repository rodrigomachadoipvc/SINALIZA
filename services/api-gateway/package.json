{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sinaliza API gateway: single entry point with routing, JWT, RBAC, CORS, rate limit and docs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm build && node --env-file=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run -c vitest.e2e.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@sinaliza/service-kit": "workspace:*",
    "@sinaliza/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "http-proxy-middleware": "4.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-dist": "5.34.0"
  },
  "devDependencies": {
    "@sinaliza/config": "workspace:*",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
