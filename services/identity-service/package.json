{
  "name": "identity-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sinaliza identity: accounts, authentication (JWT RS256), password recovery",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm build && node --env-file=../../.env dist/main.js",
    "migrate": "prisma migrate deploy",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "openapi:export": "node --env-file-if-exists=../../.env dist/export-openapi.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run -c vitest.e2e.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "start:prod": "prisma migrate deploy && node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sinaliza/service-kit": "workspace:*",
    "@sinaliza/shared": "workspace:*",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@sinaliza/config": "workspace:*",
    "@swc/core": "1.16.20",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "amqplib": "2.2.0",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
