{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sinaliza notifications: consumes domain events and sends PT-PT emails",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm build && node --env-file=../../.env dist/main.js",
    "openapi:export": "node --env-file-if-exists=../../.env dist/export-openapi.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run -c vitest.e2e.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@sinaliza/service-kit": "workspace:*",
    "@sinaliza/shared": "workspace:*",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nodemailer": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@sinaliza/config": "workspace:*",
    "@swc/core": "1.16.20",
    "@testcontainers/rabbitmq": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
