{
  "name": "backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sinaliza backoffice for municipal managers and administrators (React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 8081",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@react-leaflet/core": "3.0.0",
    "@sinaliza/shared": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-is": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-leaflet-cluster": "4.1.3",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sinaliza/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
