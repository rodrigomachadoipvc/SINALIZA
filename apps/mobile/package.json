{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Sinaliza citizen app (Expo + React Native)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8082",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/poppins": "0.4.1",
    "@expo/metro-runtime": "57.0.17",
    "@hookform/resolvers": "6.0.2",
    "@sinaliza/shared": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.21.0",
    "expo": "57.0.31",
    "expo-asset": "57.0.20",
    "expo-constants": "57.0.22",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "expo-image-manipulator": "57.0.21",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.13",
    "expo-location": "57.0.22",
    "expo-router": "57.0.29",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "leaflet": "1.9.4",
    "lucide-react-native": "1.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.91.0",
    "react-leaflet": "5.0.0",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@sinaliza/config": "workspace:*",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "testTimeout": 15000
  }
}
