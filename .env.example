# Sinaliza — environment variables. Copy to `.env` and change the passwords.
# Never commit `.env`.

# ---------------------------------------------------------------- PostgreSQL + PostGIS
# Superuser, only used by the init script and by admins.
POSTGRES_USER=sinaliza_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_PORT=5432

# One role per service database (RNF07).
IDENTITY_DB_USER=identity_svc
IDENTITY_DB_PASSWORD=change-me-identity
OCCURRENCE_DB_USER=occurrence_svc
OCCURRENCE_DB_PASSWORD=change-me-occurrence
MUNICIPAL_DB_USER=municipal_svc
MUNICIPAL_DB_PASSWORD=change-me-municipal

# ---------------------------------------------------------------- RabbitMQ
RABBITMQ_USER=sinaliza
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ---------------------------------------------------------------- Object storage (S3-compatible, RustFS)
S3_ACCESS_KEY=sinaliza-storage
S3_SECRET_KEY=change-me-storage-secret
S3_REGION=us-east-1
S3_BUCKET=occurrence-photos
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
# Host written into pre-signed photo URLs; must be reachable by the browser and the phone
# (on a real phone use the computer's LAN IP, e.g. http://192.168.1.20:9000).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# When running occurrence-service outside Docker (defaults to http://localhost:${S3_API_PORT}).
# S3_ENDPOINT=http://localhost:9000

# ---------------------------------------------------------------- Email (Mailpit locally)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---------------------------------------------------------------- JWT (RS256)
# Generated by `sh scripts/gerar-chaves.sh`; paths relative to the repository root.
JWT_PRIVATE_KEY_PATH=infra/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=infra/keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---------------------------------------------------------------- identity-service
# Public backoffice page that receives ?token= from the password-reset email (RF13).
PASSWORD_RESET_URL=http://localhost:5173/redefinir-palavra-passe
PASSWORD_RESET_TTL_MINUTES=30
# Login, register and password-recovery requests per minute per client IP.
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------- Running services outside Docker
# Services build their database/RabbitMQ URLs from the variables above. Inside Docker the compose
# file overrides these hosts; locally they default to localhost. DATABASE_URL / RABBITMQ_URL, when
# set, take precedence.
DB_HOST=localhost
RABBITMQ_HOST=localhost

# ---------------------------------------------------------------- Service-to-service calls
# Shared secret for /internal/* routes (x-internal-token). The gateway never forwards /internal.
INTERNAL_API_TOKEN=change-me-internal-token

# ---------------------------------------------------------------- occurrence-service
# municipal-service base URL for category and boundary checks (Docker: http://municipal-service:3000).
MUNICIPAL_SERVICE_URL=http://localhost:3002
# Validity of pre-signed photo URLs (RNF11: 15 minutes).
PHOTO_URL_TTL_SECONDS=900
# Reverse geocoding (Nominatim usage policy: own User-Agent, at most 1 request/s). Leave
# NOMINATIM_URL empty to disable it; addresses then fall back to the coordinates.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Sinaliza/1.0 (+https://github.com/rodrigomachadoipvc/SINALIZA)
NOMINATIM_TIMEOUT_MS=4000
