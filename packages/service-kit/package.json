{
  "name": "@sinaliza/service-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS building blocks shared by every Sinaliza service: errors, auth, events, docs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinaliza/shared": "workspace:*",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.2.0",
    "jose": "6.2.13"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/testing": "12.3.2",
    "@sinaliza/config": "workspace:*",
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "eslint": "10.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
